# Copy this file to .env and fill in real values before starting the client.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# Never put secrets here — this code ships to the browser.

# Base URL of the Express API
VITE_API_URL=http://localhost:8000

# Base URL for Socket.io connection (usually the same as the API)
VITE_SOCKET_URL=http://localhost:8000
