# Copy this file to .env and fill in real values before starting the server.
# Never commit .env to source control.

# MongoDB connection string
# Local:  mongodb://localhost:27017/webapp
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/webapp
MONGODB_URI=mongodb://localhost:27017/webapp

# JWT signing secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret

# CORS origin — must match where the client is served from
CLIENT_URL=http://localhost:5173

# Port the Express server listens on
PORT=8000

# Set to "production" for deployed environments (disables seed routes, skips test shims)
NODE_ENV=development
