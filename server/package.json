    "start": "node dist/server.js",
    "seed": "ts-node src/seedData/populateDB.ts",
    "seed:delete": "ts-node src/seedData/deleteDB.ts",
    "backfill": "ts-node src/scripts/backfillData.ts"
  },
  "dependencies": {
