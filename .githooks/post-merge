#!/usr/bin/env bash
# Regenerates the shared TS client after a pull/merge that touches
# backend/openapi.yaml, so local dev doesn't silently run against a
# stale client. Non-blocking: prints a warning instead of failing on error,
# since a failed pull shouldn't leave the working tree unusable.
set -uo pipefail

if git diff --name-only ORIG_HEAD HEAD | grep -q '^backend/openapi\.yaml$'; then
  echo "backend/openapi.yaml changed — regenerating shared/ TS client..."
  if ! npm run generate --workspace=shared --silent; then
    echo "warning: failed to regenerate shared/ client, run 'make generate' manually" >&2
  fi
fi
