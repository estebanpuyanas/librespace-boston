# Copy this file to .env and fill in real values before starting the backend.

# Port the Ktor server listens on
PORT=8081

# CORS origin allowed to call this API
CLIENT_URL=http://localhost:5173

# Local LLM config — served by the `ramalama` container in podman-compose.yml,
# OpenAI-compatible endpoint. This is the only LLM backend for this event.
RAMALAMA_URL=http://localhost:8080
RAMALAMA_MODEL=qwen2.5:7b

# ChromaDB — vector search over generated spot descriptions (see data-service/)
CHROMA_URL=http://localhost:8000

# Embeddings — served by the `ramalama-embeddings` container in podman-compose.yml
# (RamaLama serving ollama://all-minilm with --runtime-args=--embeddings, OpenAI-compatible
# /v1/embeddings). Separate container/model/port from RAMALAMA_URL/RAMALAMA_MODEL above —
# used only to embed /api/query text for Chroma similarity search, never for chat/synthesis.
EMBEDDING_URL=http://localhost:8180
EMBEDDING_MODEL=all-minilm

# Postgres connection string (Neon). Accepts the libpq-style URI Neon hands out
# (postgresql://user:pass@host/db?sslmode=require&...) — the backend rewrites it
# into a JDBC URL itself. Only read lazily, on the first request that hits
# /api/favorites, so it's not required for routes that don't touch the database.
DATABASE_URL=

# Path to data-service's joined spots index, loaded into memory at startup.
# Default (../data-service/output/spots.json) assumes the sibling checkout layout.
SPOTS_DATA_PATH=

# Coarse location fallback when a visitor declines device location. The backend sends a public
# IP to this provider only for the current request and does not persist it.
IP_GEOLOCATION_URL=https://ipapi.co

# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Current-weather provider used by the compact mobile weather card.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
