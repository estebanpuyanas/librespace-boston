# Copy this file to .env and fill in real values before starting the backend.

# Port the Ktor server listens on
PORT=8081

# CORS origin allowed to call this API
CLIENT_URL=http://localhost:5173

# Hosted LLM (primary path) — query understanding, grounded synthesis, translation.
# Leave blank to force the RamaLama fallback below.
ANTHROPIC_API_KEY=

# Local LLM fallback (offline / no API key) — served by the `ramalama` container
# in podman-compose.yml, OpenAI-compatible endpoint.
RAMALAMA_URL=http://localhost:8080
RAMALAMA_MODEL=llama3.2:3b

# ChromaDB — vector search over generated spot descriptions (see data-service/)
CHROMA_URL=http://localhost:8000
