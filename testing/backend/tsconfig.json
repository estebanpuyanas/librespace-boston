{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "shared/*": ["../../shared/$1"],
      "@server/*": ["../../server/src/$1"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
