{
  "expo": {
    "name": "LibreSpace Boston",
    "slug": "librespace-boston",
    "scheme": "librespace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/librespace-logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["en", "es", "vi", "zh-Hans"],
            "ios": ["en", "es", "vi", "zh-Hans"]
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.librespace.boston",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LibreSpace uses your location to show free places near you."
      }
    },
    "android": {
      "package": "com.librespace.boston",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#F5F4ED",
        "foregroundImage": "./assets/librespace-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LibreSpace uses your location to show free places near you."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
